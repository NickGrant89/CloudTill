DATABASE_URL="file:./dev.db"
# For Postgres: DATABASE_URL="postgresql://user:pass@localhost:5432/cloudtill"
JWT_SECRET="purepos-dev-secret-change-in-production"
PORT=4000
HOST=0.0.0.0

# Brand / public URLs (PurePOS UK)
# Production domain purepos.co.uk — hosting currently suspended; use staging for pilots.
PRODUCT_NAME="PurePOS"
PRODUCT_LEGAL="PurePOS UK"
PRODUCT_DOMAIN="purepos.co.uk"
PUBLIC_BASE_URL="http://localhost:4000"
STAGING_BASE_URL="https://staging.purepos.co.uk"

# Platform licensing admin (/admin) — required for https://purepos.co.uk/admin
# Generate with: openssl rand -hex 24
# PLATFORM_ADMIN_SECRET=

# Optional Stripe — SaaS billing prices + text-to-pay Checkout Sessions
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_MULTI=
# STRIPE_WEBHOOK_SECRET=
# Text-to-pay webhook: POST /api/public/pay/stripe/webhook

# Optional Twilio SMS for text-to-pay (link still works without SMS)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Optional absolute URLs for POS / BO / ordering when not on localhost
# POS_PUBLIC_URL="https://staging.purepos.co.uk/pos"
# BO_PUBLIC_URL="https://staging.purepos.co.uk/bo"
# ORDERING_PUBLIC_URL="https://staging.purepos.co.uk/order"
