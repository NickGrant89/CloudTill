generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Store {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  currency  String   @default("USD")
  timezone  String   @default("America/New_York")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registers          Register[]
  employees          Employee[]
  categories         Category[]
  items              Item[]
  customers          Customer[]
  inventoryLevels    InventoryLevel[]
  inventoryMovements InventoryMovement[]
  shifts             Shift[]
  tickets            Ticket[]
  sales              Sale[]
  taxes              Tax[]
  paymentTypes       PaymentType[]
  settings           Setting[]
}

model Register {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  createdAt DateTime @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shifts  Shift[]
  tickets Ticket[]
  sales   Sale[]
}

model Employee {
  id           String   @id @default(cuid())
  storeId      String
  name         String
  email        String   @unique
  pinHash      String
  pinDisplay   String // demo only: last known PIN for seed docs
  role         String   @default("cashier") // owner | manager | cashier
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shifts Shift[]
  sales  Sale[]
}

model Category {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  color     String   @default("#2F6F4E")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items Item[]
}

model Item {
  id          String   @id @default(cuid())
  storeId     String
  categoryId  String?
  name        String
  description String?
  color       String   @default("#3D5A4C")
  imageUrl    String?
  soldBy      String   @default("each") // each | weight
  isComposite Boolean  @default(false) // kit/bundle
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id])
  variants       Variant[]
  modifierGroups ModifierGroup[]
  kitComponents  KitComponent[]  @relation("KitParent")
}

model Variant {
  id         String  @id @default(cuid())
  itemId     String
  name       String  @default("Regular")
  sku        String
  barcode    String?
  priceCents Int
  costCents  Int     @default(0)
  trackStock Boolean @default(true)
  active     Boolean @default(true)

  item             Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inventoryLevels  InventoryLevel[]
  kitAsComponent   KitComponent[]    @relation("KitChild")
  ticketLines      TicketLine[]
  saleLines        SaleLine[]
}

model KitComponent {
  id              String @id @default(cuid())
  parentItemId    String
  componentVarId  String
  quantity        Float  @default(1)

  parent    Item    @relation("KitParent", fields: [parentItemId], references: [id], onDelete: Cascade)
  component Variant @relation("KitChild", fields: [componentVarId], references: [id], onDelete: Cascade)
}

model ModifierGroup {
  id        String @id @default(cuid())
  itemId    String
  name      String
  minSelect Int    @default(0)
  maxSelect Int    @default(1)

  item      Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  modifiers Modifier[]
}

model Modifier {
  id         String  @id @default(cuid())
  groupId    String
  name       String
  priceCents Int     @default(0)
  active     Boolean @default(true)

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model InventoryLevel {
  id        String @id @default(cuid())
  storeId   String
  variantId String
  quantity  Float  @default(0)
  lowStock  Float  @default(5)

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([storeId, variantId])
}

model InventoryMovement {
  id          String   @id @default(cuid())
  storeId     String
  variantId   String
  type        String // receive | sale | adjust | refund | transfer
  quantity    Float
  note        String?
  employeeId  String?
  createdAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Customer {
  id               String   @id @default(cuid())
  storeId          String
  name             String
  email            String?
  phone            String?
  note             String?
  loyaltyPoints    Int      @default(0)
  storeCreditCents Int      @default(0)
  totalSpentCents  Int      @default(0)
  visitCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  sales   Sale[]
}

model Tax {
  id        String  @id @default(cuid())
  storeId   String
  name      String
  rateBps   Int // 825 = 8.25%
  inclusive Boolean @default(false)
  enabled   Boolean @default(true)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model PaymentType {
  id          String  @id @default(cuid())
  storeId     String
  name        String
  type        String // cash | card | other | store_credit
  enabled     Boolean @default(true)
  opensDrawer Boolean @default(false)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Setting {
  id      String @id @default(cuid())
  storeId String
  key     String
  value   String

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
}

model Shift {
  id                 String    @id @default(cuid())
  storeId            String
  registerId         String
  employeeId         String
  openedAt           DateTime  @default(now())
  closedAt           DateTime?
  openingFloatCents  Int
  closingCashCents   Int?
  expectedCashCents  Int?
  differenceCents    Int?
  note               String?
  status             String    @default("open") // open | closed

  store      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  register   Register        @relation(fields: [registerId], references: [id], onDelete: Cascade)
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cashEvents CashEvent[]
  sales      Sale[]
}

model CashEvent {
  id         String   @id @default(cuid())
  shiftId    String
  type       String // pay_in | pay_out | drawer_open
  amountCents Int     @default(0)
  note       String?
  createdAt  DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
}

model Ticket {
  id              String   @id @default(cuid())
  storeId         String
  registerId      String
  employeeId      String?
  customerId      String?
  name            String   @default("Ticket")
  status          String   @default("open") // open | held | paid | voided
  discountCents   Int      @default(0)
  discountPercent Float    @default(0)
  tipCents        Int      @default(0)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store    Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  register Register     @relation(fields: [registerId], references: [id], onDelete: Cascade)
  customer Customer?    @relation(fields: [customerId], references: [id])
  lines    TicketLine[]
}

model TicketLine {
  id             String  @id @default(cuid())
  ticketId       String
  variantId      String
  name           String
  quantity       Float   @default(1)
  unitPriceCents Int
  discountCents  Int     @default(0)
  modifiersJson  String  @default("[]")
  note           String?

  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id])
}

model Sale {
  id             String   @id @default(cuid())
  receiptNumber  String
  storeId        String
  registerId     String
  employeeId     String
  customerId     String?
  shiftId        String?
  status         String   @default("completed") // completed | voided | refunded | partial_refund
  subtotalCents  Int
  discountCents  Int      @default(0)
  taxCents       Int      @default(0)
  tipCents       Int      @default(0)
  totalCents     Int
  paidCents      Int
  changeCents    Int      @default(0)
  note           String?
  createdAt      DateTime @default(now())

  store    Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  register Register      @relation(fields: [registerId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id])
  customer Customer?     @relation(fields: [customerId], references: [id])
  shift    Shift?        @relation(fields: [shiftId], references: [id])
  lines    SaleLine[]
  payments SalePayment[]
}

model SaleLine {
  id             String @id @default(cuid())
  saleId         String
  variantId      String?
  name           String
  quantity       Float
  unitPriceCents Int
  discountCents  Int    @default(0)
  taxCents       Int    @default(0)
  totalCents     Int
  modifiersJson  String @default("[]")

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id])
}

model SalePayment {
  id              String @id @default(cuid())
  saleId          String
  paymentTypeId   String
  paymentTypeName String
  amountCents     Int
  tenderedCents   Int?

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}
