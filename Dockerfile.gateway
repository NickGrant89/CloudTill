# PurePOS web gateway — static POS / BO / ordering / marketing behind nginx
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/pos/package.json apps/pos/
COPY apps/backoffice/package.json apps/backoffice/
COPY apps/ordering/package.json apps/ordering/
COPY apps/marketing/package.json apps/marketing/
RUN pnpm install --filter @cloudtill/shared --filter @cloudtill/pos --filter @cloudtill/backoffice --filter @cloudtill/ordering --filter @cloudtill/marketing --frozen-lockfile=false

COPY packages/shared packages/shared
COPY apps/pos apps/pos
COPY apps/backoffice apps/backoffice
COPY apps/ordering apps/ordering
COPY apps/marketing apps/marketing

RUN pnpm --filter @cloudtill/shared build \
  && VITE_BASE=/pos/ pnpm --filter @cloudtill/pos build \
  && VITE_BASE=/bo/ pnpm --filter @cloudtill/backoffice build \
  && VITE_BASE=/order/ pnpm --filter @cloudtill/ordering build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/apps/pos/dist /usr/share/nginx/html/pos
COPY --from=build /app/apps/backoffice/dist /usr/share/nginx/html/bo
COPY --from=build /app/apps/ordering/dist /usr/share/nginx/html/order
COPY --from=build /app/apps/marketing/index.html /usr/share/nginx/html/index.html
COPY --from=build /app/apps/marketing/assets /usr/share/nginx/html/assets
EXPOSE 80
